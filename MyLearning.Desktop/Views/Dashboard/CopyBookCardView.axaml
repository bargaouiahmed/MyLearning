<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyLearning.Desktop.ViewModels.Dashboard"
    x:Class="MyLearning.Desktop.Views.Dashboard.CopyBookCardView"
    x:DataType="vm:CopyBookCardViewModel">

    <Border
        x:Name="CardSurface"
        Width="200"
        Background="#7A7AA1"
        PointerPressed="CardSurface_PointerPressed">

    <StackPanel Spacing="8">
        <Image
            Height="150"
            Stretch="Uniform"
            Source="{Binding PreviewImage}" />

        <TextBlock
            FontWeight="Bold"
            TextAlignment="Center"
            Text="{Binding Name}" />
    </StackPanel>
</Border>
</UserControl>